---
import '@fontsource-variable/schibsted-grotesk';
import '../styles/global.css';
import { contact, copy, routes, type Lang, type PageKey } from '../content';

interface Props { lang: Lang; page: PageKey; }
const { lang, page } = Astro.props;
const t = copy[lang];
const r = routes[lang];
const [title, description] = t.meta[page];
const other: Lang = lang === 'sv' ? 'en' : 'sv';
const year = new Date().getFullYear();
const links = [['services', t.nav.services], ['about', t.nav.about]] as const;
const workHref = `${r.home}#arbeten`;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#ffffff" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
  <link rel="canonical" href={new URL(r[page], Astro.site)} />
  <link rel="alternate" hreflang="sv" href={new URL(routes.sv[page], Astro.site)} />
  <link rel="alternate" hreflang="en" href={new URL(routes.en[page], Astro.site)} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body>
  <a class="skip" href="#main">{t.skip}</a>

  <header class="nav glass" data-lens="26">
    <a class="brand" href={r.home} aria-label={t.nav.home} translate="no">Mabon Media</a>
    <nav class="nav-links" aria-label="Primary">
      <a href={workHref}>{t.nav.work}</a>
      {links.map(([key, label]) => <a href={r[key]} aria-current={page === key ? 'page' : undefined}>{label}</a>)}
    </nav>
    <a class="btn btn-ink btn-small nav-cta" href={r.contact}>{t.nav.cta}</a>
    <button class="menu-button" type="button" popovertarget="menu" aria-label={t.nav.menu}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
    </button>
  </header>

  <div id="menu" class="menu glass" popover>
    <button class="menu-close" type="button" popovertarget="menu" popovertargetaction="hide" aria-label={t.nav.close}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <nav aria-label="Mobile">
      <a href={r.home} translate="no">Mabon Media</a>
      <a href={workHref}>{t.nav.work}</a>
      {links.map(([key, label]) => <a href={r[key]}>{label}</a>)}
      <a href={r.contact}>{t.nav.cta}</a>
    </nav>
  </div>

  <a class="lang glass" data-lens="14" href={routes[other][page]} hreflang={other} lang={other} aria-label={t.langLabel} title={t.langLabel}>
    {other === 'en'
      ? <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" fill="#1f3a7a" /><path d="M0 0l32 32M32 0L0 32" stroke="#fff" stroke-width="6" /><path d="M0 0l32 32M32 0L0 32" stroke="#c8102e" stroke-width="2.4" /><path d="M16 0v32M0 16h32" stroke="#fff" stroke-width="10" /><path d="M16 0v32M0 16h32" stroke="#c8102e" stroke-width="6" /></svg>
      : <svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" fill="#0b5ea8" /><rect x="9" width="6" height="32" fill="#fecb00" /><rect y="13" width="32" height="6" fill="#fecb00" /></svg>}
  </a>

  <main id="main"><slot /></main>

  <footer class="footer">
    <div class="wrap footer-grid">
      <div>
        <p class="footer-brand" translate="no">Mabon Media AB</p>
        <p>Bigarråvägen 5<br />114 21 Stockholm, {t.footer.country}</p>
      </div>
      <nav aria-label={t.footer.nav}>
        <a href={workHref}>{t.nav.work}</a>
        {links.map(([key, label]) => <a href={r[key]}>{label}</a>)}
        <a href={r.terms}>{t.footer.terms}</a>
      </nav>
      <div class="footer-reach">
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
        <a href={contact.phoneHref}>{contact.phone}</a>
        <a href={contact.instagram}>Instagram</a>
      </div>
    </div>
    <p class="wrap footer-legal">©{year} Mabon Media AB. {t.footer.rights}</p>
  </footer>

  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
