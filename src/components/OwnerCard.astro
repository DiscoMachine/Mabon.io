---
import { Image } from 'astro:assets';
import photo from '../assets/jamie.jpg';
import { contact, copy, routes, type Lang } from '../content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
const [[baseLabel, base], [openLabel, open], [coffeeLabel, coffee]] = t.owner.stats;
---
<article class="owner-card">
  <Image class="owner-photo" src={photo} alt={t.owner.alt} widths={[420, 800]} sizes="(max-width: 860px) 100vw, 400px" format="webp" quality={84} />
  <div class="owner-scrim" aria-hidden="true"></div>
  <div class="owner-body">
    <p class="owner-name">
      <span translate="no">Jamie Mabon</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#0a84ff" d="M12 1.600l2.700 2 3.400-.2 1 3.200 2.800 1.900-1.200 3.200 1.200 3.200-2.800 1.900-1 3.200-3.400-.2-2.700 2-2.700-2-3.400.2-1-3.200-2.800-1.900L3.300 12 2.100 8.800l2.800-1.900 1-3.200 3.400.2z" /><path fill="none" stroke="#fff" stroke-width="2.200" stroke-linecap="round" stroke-linejoin="round" d="M8 12.200l2.800 2.800L16 9.600" /></svg>
    </p>
    <p class="owner-bio">{t.owner.bio}</p>
    <dl class="owner-stats">
      <div><dt>{baseLabel}</dt><dd>{base}</dd></div>
      <div><dt>{openLabel}</dt><dd><i class="owner-dot" aria-hidden="true"></i>{open}</dd></div>
      <div><dt>{coffeeLabel}</dt><dd>{coffee}</dd></div>
    </dl>
    <div class="owner-actions">
      <a class="owner-cta" href={routes[lang].contact}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="M4 7.500l8 6 8-6" /></svg>
        {t.nav.cta}
      </a>
      <a class="owner-chat" href={contact.whatsapp} aria-label="WhatsApp" title="WhatsApp">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.500a8.500 8.500 0 0 0-7.300 12.800L3.500 20.500l4.300-1.100A8.500 8.500 0 1 0 12 3.500z" /></svg>
      </a>
    </div>
  </div>
</article>
