---
import { contact, copy, type Lang } from '../content';

interface Props { lang: Lang; }
const t = copy[Astro.props.lang];
---
<section class="band closing">
  <div class="wrap">
    <h2>{t.cta.title}</h2>
    <p>{t.cta.body}</p>
    <div class="actions">
      <a class="btn btn-ink" href={`mailto:${contact.email}`}>{t.cta.email}</a>
      <a class="btn btn-quiet" href={contact.whatsapp}>WhatsApp</a>
    </div>
  </div>
</section>
