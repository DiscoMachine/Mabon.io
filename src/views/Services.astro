---
import Base from '../layouts/Base.astro';
import Closing from '../components/Closing.astro';
import VideoCard from '../components/VideoCard.astro';
import { copy, videos, type Lang } from '../content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
---
<Base lang={lang} page="services">
  <header class="page-head wrap">
    <h1>{t.services.title}</h1>
    <p class="lead">{t.services.sub}</p>
  </header>

  <section class="band band-alt">
    <div class="wrap">
      <h2>{t.services.listTitle}</h2>
      <dl class="included">
        {t.services.list.map(([name, body]) => (
          <div><dt>{name}</dt><dd>{body}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="band">
    <div class="wrap proof">
      <div class="head">
        <h2>{t.proof.title}</h2>
        <p>{t.proof.body}</p>
      </div>
      <div class="video-grid">
        {videos.map((video) => <VideoCard lang={lang} video={video} />)}
      </div>
    </div>
  </section>

  <Closing lang={lang} />
</Base>
