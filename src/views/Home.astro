---
import Base from '../layouts/Base.astro';
import Closing from '../components/Closing.astro';
import OwnerCard from '../components/OwnerCard.astro';
import VideoCard from '../components/VideoCard.astro';
import { copy, routes, videos, type Lang } from '../content';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
const r = routes[lang];
---
<Base lang={lang} page="home">
  <section class="hero wrap">
    <div class="hero-text">
      <h1>{t.hero.title}</h1>
      <p class="lead">{t.hero.sub}</p>
      <a class="btn btn-ink" href={r.contact}>{t.nav.cta}</a>
      <dl class="hero-stats" aria-label={t.hero.statsLabel}>
        {t.hero.stats.map(([value, label]) => (
          <div><dt>{label}</dt><dd>{value}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="band band-alt" id="arbeten">
    <div class="wrap proof">
      <div class="head">
        <h2>{t.proof.title}</h2>
        <p>{t.proof.body}</p>
      </div>
      <div class="video-grid">
        {videos.map((video) => <VideoCard lang={lang} video={video} />)}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap intro">
      <OwnerCard lang={lang} />
      <div>
        <h2>{t.intro.title}</h2>
        <p class="lead">{t.intro.body}</p>
        <a class="text-link" href={r.about}>{t.intro.link}</a>
      </div>
    </div>
  </section>

  <section class="band band-alt">
    <div class="wrap">
      <div class="head">
        <h2>{t.fit.title}</h2>
        <p>{t.fit.body}</p>
      </div>
      <div class="compare">
        <div class="compare-card compare-yes">
          <h3>{t.fit.yesTitle}</h3>
          <ul>
            {t.fit.yes.map((item) => (
              <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.500l4.500 4.500L19 7.500" /></svg>{item}</li>
            ))}
          </ul>
        </div>
        <div class="compare-card compare-no">
          <h3>{t.fit.noTitle}</h3>
          <ul>
            {t.fit.no.map((item) => (
              <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.500 6.500l11 11M17.500 6.500l-11 11" /></svg>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2>{t.process.title}</h2>
      <ol class="steps">
        {t.process.steps.map(([name, body], index) => (
          <li><span>{index + 1}</span><h3>{name}</h3><p>{body}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band band-alt">
    <div class="wrap faq">
      <div>
        <h2>{t.faq.title}</h2>
        <a class="text-link" href={r.terms}>{t.faq.terms}</a>
      </div>
      <div class="faq-list">
        {t.faq.items.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Closing lang={lang} />
</Base>
